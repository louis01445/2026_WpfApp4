<Window x:Class="_2026_WpfApp4.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_WpfApp4"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewCommands_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommandBinding_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommands_Executed"/>
    </Window.CommandBindings>
    <DockPanel>
        <ToolBarTray Height="40" Background="Aqua" DockPanel.Dock="Top" Width="796">
            <ToolBar x:Name="ApplicationToolbar" Height="40" Background="#FF00B3FF" Margin="0,0,-10,0">
                <Button x:Name="NewButton" Height="38" Width="38" Command="ApplicationCommands.New">
                    <Image Height="32" Width="32" Source="C:\Users\USER\source\repos\2026_WpfApp4\2026_WpfApp4\img\new.png" />
                </Button>
                <Button x:Name="OPenButton" Height="38" Width="38" Command="ApplicationCommands.Open">
                    <Image Height="32" Width="32" Source="C:\Users\USER\source\repos\2026_WpfApp4\2026_WpfApp4\img\open.png"/>
                </Button>
                <Button x:Name="Savebutton" Height="32" Width="32" Command="ApplicationCommands.Save">
                    <Image Height="32" Width="32" Source="C:\Users\USER\source\repos\2026_WpfApp4\2026_WpfApp4\img\save.png" />
                </Button>
                <Button x:Name="Trashbutton" Height="32" Width="38" Click="Trashbutton_Click" >
                    <Image Height="32" Width="38" Source="C:\Users\USER\source\repos\2026_WpfApp4\2026_WpfApp4\img\trash.png" />
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditingToolbar" Height="40" Background="#FF0FFFCE" Margin="0,0,100,0">
                <ToggleButton x:Name="Boldbutton" Height="38" Width="38" Command="EditingCommands.ToggleBold">
                    <Image Height="32" Width="38" Source="C:\Users\USER\source\repos\2026_WpfApp4\2026_WpfApp4\img\bold.png" />
                </ToggleButton>
                <ToggleButton Height="38" Width="38" x:Name="Italicbutton" Command="EditingCommands.ToggleItalic">
                    <Image Height="32" Width="32" Source="C:\Users\USER\source\repos\2026_WpfApp4\2026_WpfApp4\img\italic.png" />
                </ToggleButton>
                <ToggleButton x:Name="Underlinebutton" Height="38" Width="38" Command="EditingCommands.ToggleUnderline">
                    <Image Height="32" Width="28" Source="C:\Users\USER\source\repos\2026_WpfApp4\2026_WpfApp4\img\underline.png" />
                </ToggleButton>
                <xctk:ColorPicker x:Name="FontColorPicker" Width="160" Height="38" SelectedColorChanged="FontColorPicker_SelectedColorChanged" />
                <ComboBox x:Name="FontFamilyCombobox" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="38" Margin="5, 0 ,0 ,0" SelectionChanged="FontFamilyCombobox_SelectionChanged"/>
                <ComboBox x:Name="FontsizeCombobox" HorizontalAlignment="Left" Width="60" Height="38" SelectionChanged="FontsizeCombobox_SelectionChanged"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar Height="30" DockPanel.Dock="Bottom" Background="LightGray"/>
        <RichTextBox x:Name="MainRichTextbox" Background="Red" SelectionChanged="MainRIchTextBox_">
            <FlowDocument/>
        </RichTextBox>
    </DockPanel>
</Window>
